# Copie para .env e ajuste. Funciona com QUALQUER instância do OWASP ZAP.

# Endereço da API do ZAP (daemon ou interface com API ativa)
ZAP_BASE_URL=http://127.0.0.1:8080

# API key do ZAP (veja em ~/.ZAP/config.xml -> <api><key>).
# Deixe vazio só se o ZAP estiver com a API sem chave (não recomendado).
ZAP_API_KEY=

# Timeout das requisições em segundos
ZAP_TIMEOUT=60

# (Opcional) Allowlist de hosts que podem ser escaneados, separados por vírgula.
# Vazio = qualquer alvo. Ex.: exemplo.com,.meudominio.com
ZAP_ALLOWED_HOSTS=

# (Opcional) false desabilita scans ativos (intrusivos)
ZAP_ALLOW_ACTIVE_SCAN=true
